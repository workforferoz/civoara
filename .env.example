# CIVOARA - Environment Variables Configuration

# Supabase Public Configuration (Browser & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server-Only Secret (NEVER expose to browser/client-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron & Background Worker Authentication Secret
CRON_SECRET=your-secure-random-cron-secret

# Geospatial & Map Defaults
NEXT_PUBLIC_MAP_DEFAULT_LAT=12.9716
NEXT_PUBLIC_MAP_DEFAULT_LNG=77.5946
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=13
